<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swri_transform_util</name>
  <version>3.11.0</version>
  <description>

     The swri_transform_util package contains utility functions and classes for
     transforming between coordinate frames.

  </description>
  <author>Marc Alban</author>
  <maintainer email="swri-robotics@swri.org">Southwest Research Institute</maintainer>
  <license>BSD</license>
  <url>https://github.com/swri-robotics/marti_common</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>proj</depend>
  <depend>rclcpp</depend>
  <depend>swri_math_util</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>yaml_cpp_vendor</depend>

  <!-- Used by the nodes and the .cpp files, never by the installed headers. -->
  <build_depend>geographic_msgs</build_depend>
  <build_depend>geographiclib</build_depend>
  <build_depend>gps_msgs</build_depend>
  <build_depend>marti_nav_msgs</build_depend>
  <build_depend>rcl_interfaces</build_depend>
  <build_depend>rclcpp_components</build_depend>

  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>geographiclib</exec_depend>
  <exec_depend>gps_msgs</exec_depend>
  <exec_depend>marti_nav_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>

  <!-- Imported by initialize_origin.py and swri_transform_util/*.py only. -->
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rosdoc config="rosdoc.yaml" />
  </export>
</package>

